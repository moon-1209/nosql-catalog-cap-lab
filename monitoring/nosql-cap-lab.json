    {
      "type": "timeseries",
      "title": "p99 latency theo node (ms)",
      "id": 10,
      "description": "Summary của Scylla tính theo micro-giây, đã chia 1000 sang ms. Khi giả lập replica chậm 100ms: CL=ALL tăng rõ, CL=ONE gần như không đổi.",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (instance) (scylla_storage_proxy_coordinator_read_latency_summary{quantile=\"0.99\", scheduling_group_name=~\"statement|sl:.*\"}) / 1000",
          "legendFormat": "read p99 {{instance}}",
          "refId": "A",
          "range": true
        },
        {
          "expr": "max by (instance) (scylla_storage_proxy_coordinator_write_latency_summary{quantile=\"0.99\", scheduling_group_name=~\"statement|sl:.*\"}) / 1000",
