    {
      "type": "timeseries",
      "title": "Unavailable/s theo node (coordinator từ chối ngay)",
      "id": 6,
      "description": "Unavailable = coordinator BIẾT không đủ replica sống cho CL yêu cầu → trả lỗi ngay (fail-fast).",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(scylla_storage_proxy_coordinator_write_unavailable[30s]))",
          "legendFormat": "write {{instance}}",
          "refId": "A",
          "range": true
        },
        {
          "expr": "sum by (instance) (rate(scylla_storage_proxy_coordinator_read_unavailable[30s]))",
          "legendFormat": "read {{instance}}",
          "refId": "B",
          "range": true
