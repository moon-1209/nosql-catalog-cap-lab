    {
      "type": "timeseries",
      "title": "Mất cân bằng tải max/mean (1.0 = đều tuyệt đối)",
      "id": 13,
      "description": "Với 3 node và RF=3, mọi node giữ mọi partition nên chỉ số 'theo node' luôn ≈ 1. Muốn thấy lệch phải nhìn 'theo shard' hoặc chạy với node 4 (N > RF).",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max((sum by (instance, shard) (rate(scylla_database_total_reads[30s])) + sum by (instance, shard) (rate(scylla_database_total_writes[30s])))) / avg((sum by (instance, shard) (rate(scylla_database_total_reads[30s])) + sum by (instance, shard) (rate(scylla_database_total_writes[30s]))))",
          "legendFormat": "theo shard",
          "refId": "A",
          "range": true
        },
        {
          "expr": "max((sum by (instance) (rate(scylla_database_total_reads[30s])) + sum by (instance) (rate(scylla_database_total_writes[30s])))) / avg((sum by (instance) (rate(scylla_database_total_reads[30s])) + sum by (instance) (rate(scylla_database_total_writes[30s]))))",
          "legendFormat": "theo node",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
