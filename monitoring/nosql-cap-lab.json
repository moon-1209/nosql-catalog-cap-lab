      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum by (instance, shard) (rate(scylla_database_total_reads[30s])) + sum by (instance, shard) (rate(scylla_database_total_writes[30s])))",
