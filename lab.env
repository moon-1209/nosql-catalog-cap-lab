# =====================================================================
# lab.env — CẤU HÌNH CHUNG CỦA LAB (phần của Lâm – DevOps)
# Dùng cho cả docker compose (--env-file) lẫn script bash (source).
# Quy tắc: KEY=VALUE, không khoảng trắng, KHÔNG comment cùng dòng.
# Muốn đổi IP/phiên bản: chỉ sửa ở đây, mọi script đều đọc lại file này.
# =====================================================================

# ---- Phiên bản image (pin để kết quả tái lập được) ----
# Sau lần pull đầu tiên nên pin luôn bản vá, ví dụ scylladb/scylla:2026.1.15
SCYLLA_IMAGE=scylladb/scylla:2026.1
MONGO_IMAGE=mongo:8.0
CADVISOR_IMAGE=ghcr.io/google/cadvisor:0.56.1
CHAOS_IMAGE=nicolaka/netshoot:v0.15
SCYLLA_MONITORING_VERSION=4.16.3

# ---- Mạng Docker dùng chung (IP tĩnh ở nửa dưới, IP động ở nửa trên) ----
LAB_NETWORK=lab-net
LAB_SUBNET=10.88.88.0/24
LAB_IP_RANGE=10.88.88.128/25
LAB_GATEWAY=10.88.88.1
SCYLLA1_IP=10.88.88.11
SCYLLA2_IP=10.88.88.12
SCYLLA3_IP=10.88.88.13
SCYLLA4_IP=10.88.88.14
CADVISOR_IP=10.88.88.21
MONGO1_IP=10.88.88.31
MONGO2_IP=10.88.88.32
MONGO3_IP=10.88.88.33

# ---- ScyllaDB ----
# SMP=2: mỗi node 2 shard → mới thấy được hot partition ở mức shard (xem README tuần 2)
SCYLLA_CLUSTER_NAME=nosql-cap-lab
SCYLLA_DC=dc1
SCYLLA_SMP=2
SCYLLA_MEMORY=1G
# Nếu node không khởi động được vì "Could not setup Async I/O" → đổi thành epoll
SCYLLA_REACTOR_BACKEND=linux-aio
# Node 4 vào rack/AZ đã có để keyspace vẫn RF-rack-valid (RF=3, 3 rack)
NODE4_RACK=rack1

# ---- MongoDB Replica Set ----
MONGO_RS=rs0
MONGO_WT_CACHE_GB=0.5

# ---- Monitoring ----
PROM_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
SCRAPE_INTERVAL_S=5
PROM_RETENTION=60d
